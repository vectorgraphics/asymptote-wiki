[Unit]
Description=Asymptote Wiki
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=asymptote
Group=asymptote
WorkingDirectory=/home/asymptote/asymptote-wiki
Environment=ASY_BINARY=/usr/local/bin/asy
Environment=WIKI_DATA_DIR=/var/lib/asywiki
EnvironmentFile=/etc/asywiki/secret.env
Environment=COMPILE_TIMEOUT=120
Environment=WIKI_PREFIX=/wiki
# Single worker: the compile concurrency semaphore is per-process.
# --timeout 130: page creation compiles synchronously (up to 120s per
# file); gunicorn's default 30s would kill the worker mid-request.
# --access-logfile -: keep request logs in the journal as before.
ExecStart=/home/asymptote/asymptote-wiki/venv/bin/gunicorn --workers 1 --bind 127.0.0.1:8080 --timeout 130 --access-logfile - app:app
RestartSec=1
Restart=on-failure

[Install]
WantedBy=multi-user.target
