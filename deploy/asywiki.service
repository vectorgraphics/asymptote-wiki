
[Unit]
Description=Asymptote Wiki
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=asymptote
Group=asymptote
WorkingDirectory=/opt/asywiki
Environment=ASY_BINARY=/usr/local/bin/asy
Environment=WIKI_DATA_DIR=/var/lib/asywiki
Environment=WIKI_HOST=127.0.0.1
Environment=WIKI_PORT=8080
Environment=COMPILE_TIMEOUT=30
Environment=MAX_SOURCE_SIZE=100000
Environment=WIKI_PREFIX=/wiki
Environment=WIKI_GIT_USER=asywiki
Environment=WIKI_GIT_EMAIL=asywiki@localhost
Environment=GITHUB_REMOTE=git@github.com:vectorgraphics/asymptote-wiki-data.git
ExecStart=/opt/asywiki/venv/bin/python /opt/asywiki/app.py
RestartSec=1
Restart=on-failure

[Install]
WantedBy=multi-user.target

