[Unit]
Description=Asymptote Wiki
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=asymptote
Group=asymptote
WorkingDirectory=/home/asymptote/asymptote-wiki
Environment=ASY_BINARY=/usr/local/bin/asy
Environment=WIKI_DATA_DIR=/var/lib/asywiki
EnvironmentFile=/etc/asywiki/secret.env
Environment=WIKI_HOST=127.0.0.1
Environment=WIKI_PORT=8080
Environment=COMPILE_TIMEOUT=30
Environment=MAX_SOURCE_SIZE=100000
Environment=WIKI_PREFIX=/wiki
ExecStart=/home/asymptote/asymptote-wiki/venv/bin/python /home/asymptote/asymptote-wiki/app.py
RestartSec=1
Restart=on-failure

[Install]
WantedBy=multi-user.target
